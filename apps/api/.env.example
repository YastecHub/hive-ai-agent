# ───────────────────────────── Hive API ─────────────────────────────
NODE_ENV=development
PORT=4000
# Public base URL of this API (used for webhooks & payment redirects).
# Locally, set this to your tunnel URL, e.g. https://abc123.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:4000

# ───────────────────────────── Database ─────────────────────────────
# Easiest zero-setup option: a free Neon (neon.tech) or Supabase Postgres.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hive?sslmode=require

# ───────────────────────────── AI (Groq) ────────────────────────────
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Text + tool-calling model. openai/gpt-oss-20b = reliable tool-calling + headroom.
# (llama-3.1-8b-instant is faster/cheaper but unreliable with many tools;
#  llama-3.3-70b-versatile is highest quality but only ~100k tokens/day on free tier.)
GROQ_MODEL=openai/gpt-oss-20b
# Vision model used when a product image is sent (image -> listing).
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ──────────────────────────── WhatsApp ──────────────────────────────
# Which provider to use: "twilio" (fast, sandbox in minutes) or "meta".
WHATSAPP_PROVIDER=twilio

# --- Twilio WhatsApp (https://console.twilio.com) ---
# Twilio Sandbox: Messaging > Try it out > Send a WhatsApp message.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio WhatsApp sender (sandbox default shown). Format: whatsapp:+E164
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Set true in production to verify inbound X-Twilio-Signature.
TWILIO_VALIDATE_SIGNATURE=false
# Native quick-reply button templates (create via scripts/setup-twilio-content.mjs):
TWILIO_CONTENT_WELCOME_SID=

# --- Meta WhatsApp Cloud API (only if WHATSAPP_PROVIDER=meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; must match what you enter in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=hive-verify-token
WHATSAPP_API_VERSION=v21.0

# ─────────────────────────── Cloudinary (optional) ──────────────────
CLOUDINARY_URL=

# Keep-alive self-ping interval (ms) - stops Render free tier from sleeping (prod only).
KEEPALIVE_INTERVAL_MS=60000

# ─────────────────────── Voice commerce (BimpeAI) ───────────────────
# See docs/VOICE-COMMERCE.md. BimpeAI calls /api/voice-tools/* with this header key.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
VOICE_TOOL_KEY=
# The store the voice agent sells for (merchant WhatsApp phone, digits only).
# Demo fixture: 2348100000010 (Adunni Fashion, created by pnpm db:seed).
VOICE_STORE_PHONE=
# Separate key for the merchant inventory voice agent (optional).
VOICE_MERCHANT_TOOL_KEY=
QUOTE_TTL_MINUTES=15
RESERVATION_TTL_MINUTES=30
# Informational: the number customers call, shown in the console.
VOICE_PHONE_NUMBER=
# For scripts/setup-bimpe-agent.mjs (Console → Team settings → API keys).
BIMPEAI_API_KEY=
# Set after the first setup run so re-runs update the same agent.
BIMPEAI_AGENT_ID=
BIMPEAI_MERCHANT_AGENT_ID=

# ─────────────────────────── Paystack (test) ────────────────────────
# Use a sk_test_ key for the demo. Webhook URL: <PUBLIC_BASE_URL>/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=
# Checkout email when the caller doesn't give one. Use a team-owned test inbox and
# disclose it in the demo. Leave empty to require the caller's email.
PAYSTACK_DEMO_EMAIL=
