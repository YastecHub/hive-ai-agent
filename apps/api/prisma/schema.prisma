// Hive - data model
// The single source of truth for merchants, products, customers, orders and payments.
// Everything flows from a WhatsApp conversation; the AI agent reads/writes these tables.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Merchant ─────────────────────────────
// The business owner. Identified by their WhatsApp number. One merchant = one store (MVP).
model Merchant {
  id            String   @id @default(cuid())
  whatsappPhone String   @unique // E.164, e.g. 2348012345678
  businessName  String?
  ownerName     String?
  category      String? // fashion, food, electronics, pharmacy, salon, etc.
  currency      String   @default("NGN")
  onboarded     Boolean  @default(false)
  // Store info customers ask about ("where are you?", "do you deliver?", "hours?").
  address       String?
  businessHours String? // freeform, e.g. "Mon–Sat 9am–6pm"
  deliveryInfo  String? // freeform, e.g. "We deliver in Lagos, ₦2,000 flat"
  contactInfo   String? // phone/email/handle to reach the business
  about         String? // short description / bio
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products      Product[]
  customers     Customer[]
  orders        Order[]
  conversations Conversation[]
  supportTickets SupportTicket[]
  quotes        Quote[]
  activities    Activity[]
  stockAdjustments StockAdjustment[]

  @@index([whatsappPhone])
}

// ───────────────────────────── Product ──────────────────────────────
model Product {
  id          String   @id @default(cuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  priceKobo   Int // price in minor units (kobo). 1 NGN = 100 kobo.
  // On-hand units. Sellable now = stock - reserved.
  stock       Int      @default(0)
  // Units held by unpaid voice orders. Released on expiry/cancel; on verified
  // payment both stock and reserved drop by the order quantity.
  reserved    Int      @default(0)
  // Optional variant attributes. Each sellable variant is its own row, so
  // "Ankara Classic Gown" in Black/12 and Black/14 are two products sharing a name.
  color       String?
  size        String?
  imageUrl    String?
  sku         String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@index([merchantId])
}

// ───────────────────────────── Customer ─────────────────────────────
// A buyer who interacts with a specific merchant via WhatsApp.
model Customer {
  id            String   @id @default(cuid())
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  whatsappPhone String
  name          String?
  lastOrderedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders        Order[]
  conversations Conversation[]
  supportTickets SupportTicket[]

  @@unique([merchantId, whatsappPhone])
  @@index([merchantId])
}

// ───────────────────────────── Order ────────────────────────────────
enum OrderStatus {
  RESERVED // voice order confirmed by customer; stock reserved, awaiting verified payment
  CONFIRMED // placed by customer, stock decremented, awaiting fulfillment
  FULFILLED // delivered / completed by merchant
  CANCELLED // cancelled by merchant or customer, stock restored
  EXPIRED // reservation lapsed before payment; reserved stock released
}

enum PaymentStatus {
  NOT_REQUIRED // WhatsApp orders - payment handled off-platform
  UNPAID // awaiting payment (no checkout started)
  PENDING // checkout initialised with the payment provider
  PAID // verified with the provider; stock finalised
  NEEDS_REVIEW // verified payment arrived for an order that can no longer be fulfilled
}

enum Fulfilment {
  PICKUP
  DELIVERY
}

model Order {
  id         String      @id @default(cuid())
  reference  String      @unique // human-friendly ref, e.g. HIVE-AB12CD
  merchantId String
  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status     OrderStatus @default(CONFIRMED)
  totalKobo  Int         @default(0)
  channel    String      @default("whatsapp") // whatsapp | voice
  fulfilment Fulfilment  @default(PICKUP)
  // The quote this order was confirmed from. Unique => one order per quote.
  quoteId    String?     @unique
  quote      Quote?      @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  reservationExpiresAt DateTime?
  paymentStatus    PaymentStatus @default(NOT_REQUIRED)
  paymentReference String?       @unique // our reference sent to Paystack
  checkoutUrl      String?
  paidAt           DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items      OrderItem[]
  activities Activity[]

  @@index([status, reservationExpiresAt])

  @@index([merchantId])
  @@index([customerId])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  nameSnapshot  String // product name captured at order time
  priceKobo     Int // unit price captured at order time
  quantity      Int     @default(1)

  @@index([orderId])
}

// ──────────────────── Support / complaints ──────────────────────────
enum TicketStatus {
  OPEN
  RESOLVED
}

model SupportTicket {
  id         String       @id @default(cuid())
  merchantId String
  merchant   Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  phone      String
  category   String       @default("complaint") // complaint | question | refund | other
  message    String
  orderRef   String? // related order, if any
  status     TicketStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([merchantId])
}

// ──────────────────── Conversation & Message (AI memory) ─────────────
// One conversation thread per phone number per merchant context.
enum Party {
  MERCHANT
  CUSTOMER
}

model Conversation {
  id         String   @id @default(cuid())
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  party      Party
  phone      String // the WhatsApp number this thread belongs to
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages Message[]

  @@unique([phone, party])
  @@index([merchantId])
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String // text content or serialized tool call/result
  toolName       String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// ──────────────────── Quotes (voice ordering) ───────────────────────
// A server-priced offer the voice agent reads back before the customer confirms.
// Confirmation must name the quote id AND its current version, so the order is
// always for exactly what was read aloud.
enum QuoteStatus {
  OPEN
  CONFIRMED
  EXPIRED
}

model Quote {
  id            String      @id @default(cuid())
  merchantId    String
  merchant      Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  sessionId     String? // opaque voice session/conversation id; must match on confirm when set
  customerPhone String? // as stated by the caller - NOT verified
  customerName  String?
  productId     String
  nameSnapshot  String
  unitKobo      Int
  quantity      Int
  totalKobo     Int
  fulfilment    Fulfilment  @default(PICKUP)
  version       Int         @default(1)
  status        QuoteStatus @default(OPEN)
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  order Order?

  @@index([merchantId])
}

// ──────────────────── Activity log ──────────────────────────────────
// Append-only business events shown in the merchant console.
model Activity {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type       String // e.g. quote.created, order.reserved, payment.verified, reservation.expired
  message    String
  data       Json?
  createdAt  DateTime @default(now())

  @@index([merchantId, createdAt])
}

// ──────────────────── Merchant stock adjustments ────────────────────
// Merchant voice writes are two-step: propose, then explicitly confirm.
enum AdjustmentStatus {
  PROPOSED
  APPLIED
  REJECTED
}

model StockAdjustment {
  id         String           @id @default(cuid())
  merchantId String
  merchant   Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  productId  String
  delta      Int
  status     AdjustmentStatus @default(PROPOSED)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([merchantId])
}
